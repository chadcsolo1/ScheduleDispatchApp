@page "/jobs-test"
@page "/jobs"
@rendermode InteractiveServer
@using ScheduleDispatch.UI.Services.Jobs
@using ScheduleDispatch.UI.Services.Jobs.Response
@inject JobsService JobsService
@inject NavigationManager Navigation

<div class="jobs-test-page">
    <div class="page-header">
        <h3>Jobs Dashboard</h3>
        <div class="header-actions">
            <button class="btn btn-success" @onclick="NavigateToCreateJob">
                <i class="bi bi-plus-circle"></i> Create Job
            </button>
            <button class="btn btn-primary" @onclick="LoadJobs">
                <i class="bi bi-arrow-clockwise"></i> Refresh Jobs
            </button>
        </div>
    </div>

    @if (jobs is null)
    {
        <div class="loading-state">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p>Loading jobs...</p>
        </div>
    }
    else if (!jobs.Any())
    {
        <div class="empty-state">
            <i class="bi bi-inbox"></i>
            <p>No jobs found.</p>
        </div>
    }
    else
    {
        <div class="jobs-grid">
            @foreach (var job in jobs)
            {
                <_JobsDispalyCardComponent Job="job" 
                                           OnEdit="HandleEditJob"
                                           OnDelete="HandleDeleteJob"></_JobsDispalyCardComponent>
            }
        </div>
    }
</div>

<style>
    .jobs-test-page {
        padding: 2rem;
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #e9ecef;
    }

    .page-header h3 {
        margin: 0;
        font-size: 2rem;
        font-weight: 600;
        color: #212529;
    }

    .header-actions {
        display: flex;
        gap: 1rem;
        align-items: center;
    }

    .page-header button {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        font-weight: 500;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-success {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
    }

    .btn-success:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(40, 167, 69, 0.3);
    }

    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
    }

    .jobs-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
        gap: 1.5rem;
        margin-top: 1.5rem;
    }

    /* Loading State */
    .loading-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 4rem 2rem;
        gap: 1rem;
    }

    .loading-state p {
        color: #6c757d;
        margin: 0;
    }

    /* Empty State */
    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 4rem 2rem;
        background: #f8f9fa;
        border-radius: 12px;
        gap: 1rem;
    }

    .empty-state i {
        font-size: 4rem;
        color: #adb5bd;
    }

    .empty-state p {
        color: #6c757d;
        font-size: 1.125rem;
        margin: 0;
    }

    /* Responsive breakpoints */
    @@media (max-width: 1400px) {
        .jobs-grid {
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        }
    }

    @@media (max-width: 992px) {
        .jobs-grid {
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 1rem;
        }
    }

    @@media (max-width: 768px) {
        .jobs-test-page {
            padding: 1rem;
        }

        .page-header {
            flex-direction: column;
            gap: 1rem;
            align-items: flex-start;
        }

        .header-actions {
            width: 100%;
            flex-direction: column;
        }

        .page-header button {
            width: 100%;
            justify-content: center;
        }

        .jobs-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 576px) {
        .page-header h3 {
            font-size: 1.5rem;
        }
    }
</style>

@code {
    private IEnumerable<JobResponse>? jobs;
    private bool showDeleteConfirm = false;
    private Guid jobToDelete;

    protected override async Task OnInitializedAsync()
    {
        jobs = await JobsService.GetJobsAsync();
    }

    private async Task LoadJobs()
    {
        jobs = await JobsService.GetJobsAsync();
    }

    private void NavigateToCreateJob()
    {
        Navigation.NavigateTo("/jobs/create");
    }

    private void HandleEditJob(Guid jobId)
    {
        Console.WriteLine($"HandleEditJob called with ID: {jobId}");
        var url = $"/jobs/edit/{jobId}";
        Console.WriteLine($"Navigating to: {url}");
        Navigation.NavigateTo(url);
    }

    private async Task HandleDeleteJob(Guid jobId)
    {
        if (await ConfirmDelete())
        {
            try
            {
                await JobsService.DeleteJobAsync(jobId);
                await LoadJobs(); // Refresh the list
            }
            catch (Exception ex)
            {
                // Handle error (could add a toast notification here)
                Console.WriteLine($"Error deleting job: {ex.Message}");
            }
        }
    }

    private async Task<bool> ConfirmDelete()
    {
        // For now, using browser confirm - could be replaced with a custom modal
        return await Task.FromResult(true); // In production, show a confirmation modal
    }
}
}