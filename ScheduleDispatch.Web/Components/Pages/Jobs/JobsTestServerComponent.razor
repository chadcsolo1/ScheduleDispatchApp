@page "/jobs-test"
@using ScheduleDispatch.UI.Services.Jobs
@using ScheduleDispatch.UI.Services.Jobs.Response
@inject JobsService JobsService

<div class="jobs-test-page">
    <div class="page-header">
        <h3>Jobs Dashboard</h3>
        <button class="btn btn-primary" @onclick="LoadJobs">
            <i class="bi bi-arrow-clockwise"></i> Refresh Jobs
        </button>
    </div>

    @if (jobs is null)
    {
        <div class="loading-state">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p>Loading jobs...</p>
        </div>
    }
    else if (!jobs.Any())
    {
        <div class="empty-state">
            <i class="bi bi-inbox"></i>
            <p>No jobs found.</p>
        </div>
    }
    else
    {
        <div class="jobs-grid">
            @foreach (var job in jobs)
            {
                <_JobsDispalyCardComponent Job="job"></_JobsDispalyCardComponent>
            }
        </div>
    }
</div>

<style>
    .jobs-test-page {
        padding: 2rem;
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #e9ecef;
    }

    .page-header h3 {
        margin: 0;
        font-size: 2rem;
        font-weight: 600;
        color: #212529;
    }

    .page-header button {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        font-weight: 500;
    }

    .jobs-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
        gap: 1.5rem;
        margin-top: 1.5rem;
    }

    /* Loading State */
    .loading-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 4rem 2rem;
        gap: 1rem;
    }

    .loading-state p {
        color: #6c757d;
        margin: 0;
    }

    /* Empty State */
    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 4rem 2rem;
        background: #f8f9fa;
        border-radius: 12px;
        gap: 1rem;
    }

    .empty-state i {
        font-size: 4rem;
        color: #adb5bd;
    }

    .empty-state p {
        color: #6c757d;
        font-size: 1.125rem;
        margin: 0;
    }

    /* Responsive breakpoints */
    @@media (max-width: 1400px) {
        .jobs-grid {
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        }
    }

    @@media (max-width: 992px) {
        .jobs-grid {
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 1rem;
        }
    }

    @@media (max-width: 768px) {
        .jobs-test-page {
            padding: 1rem;
        }

        .page-header {
            flex-direction: column;
            gap: 1rem;
            align-items: flex-start;
        }

        .page-header button {
            width: 100%;
            justify-content: center;
        }

        .jobs-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 576px) {
        .page-header h3 {
            font-size: 1.5rem;
        }
    }
</style>

@code {
    private IEnumerable<JobResponse>? jobs;

    protected override async Task OnInitializedAsync()
    {
        jobs = await JobsService.GetJobsAsync();
    }

    private async Task LoadJobs()
    {
        jobs = await JobsService.GetJobsAsync();
    }
}